{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "820px",
      "wideSize": "1320px"
    },
    "useRootPaddingAwareAlignments": true,
    "color": {
      "custom": true,
      "customGradient": true,
      "defaultPalette": false,
      "palette": [
        { "slug": "base", "name": "Base", "color": "#ffffff" },
        { "slug": "cream", "name": "Cream", "color": "#eef1ea" },
        { "slug": "contrast", "name": "Contrast", "color": "#111111" },
        { "slug": "primary", "name": "Primary Green", "color": "#457F55" },
        { "slug": "secondary", "name": "Sage", "color": "#A0B89D" },
        { "slug": "accent", "name": "Gold", "color": "#F8CE4A" },
        { "slug": "orange", "name": "Orange", "color": "#E9765B" }
      ]
    },
    "typography": {
      "fluid": true,
      "customFontSize": true,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Montserrat",
          "fontFamily": "\"Montserrat\", system-ui, sans-serif"
        },
        {
          "slug": "display",
          "name": "Luxia Display",
          "fontFamily": "\"Luxia Display\", Georgia, serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "clamp(1.5rem, 3vw, 2.25rem)" },
        { "slug": "x-large", "name": "XL", "size": "clamp(2.25rem, 6vw, 4rem)" }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "customSpacingSize": true
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "lineHeight": "1.5" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400" } },
      "link": { "color": { "text": "var(--wp--preset--color--primary)" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
